{
  "character": "viktor",
  "voice_name": "Helmut - German Epic",
  "model_id": "eleven_multilingual_v2",
  "phrases": [
    { "id": "greet_01",  "category": "gruss",     "text": "He. Wer bist du?" },
    { "id": "greet_02",  "category": "gruss",     "text": "Schon gut. Ich tu dir nichts." },
    { "id": "greet_03",  "category": "gruss",     "text": "Hmpf. Noch einer, der lebt." },
    { "id": "greet_04",  "category": "gruss",     "text": "Bleib ruhig. Ich bin Viktor." },
    { "id": "warn_01",   "category": "warnung",   "text": "Bleib weg!" },
    { "id": "warn_02",   "category": "warnung",   "text": "Letzte Warnung!" },
    { "id": "warn_03",   "category": "warnung",   "text": "Waffe runter. Sofort." },
    { "id": "warn_04",   "category": "warnung",   "text": "Komm nicht näher!" },
    { "id": "warn_05",   "category": "warnung",   "text": "Das war keine Bitte." },
    { "id": "follow_01", "category": "folgen",    "text": "Geh voran." },
    { "id": "follow_02", "category": "folgen",    "text": "Gut. Ich komme mit." },
    { "id": "follow_03", "category": "folgen",    "text": "Ich bleib hinter dir." },
    { "id": "follow_04", "category": "folgen",    "text": "Hier trennen sich unsere Wege." },
    { "id": "combat_01", "category": "kampf",     "text": "Verdammt!" },
    { "id": "combat_02", "category": "kampf",     "text": "Die Dinger schon wieder!" },
    { "id": "combat_03", "category": "kampf",     "text": "Runter!" },
    { "id": "combat_04", "category": "kampf",     "text": "Lauf! Ich halt sie auf!" },
    { "id": "combat_05", "category": "kampf",     "text": "Erledigt." },
    { "id": "help_01",   "category": "hilfe",     "text": "Hilfe! Hierher!" },
    { "id": "help_02",   "category": "hilfe",     "text": "Ich brauch einen Verband!" },
    { "id": "help_03",   "category": "hilfe",     "text": "Hast du was zu essen?" },
    { "id": "help_04",   "category": "hilfe",     "text": "Wasser. Bitte." },
    { "id": "talk_01",   "category": "smalltalk", "text": "Schöner Tag. Für Tschernarus-Verhältnisse." },
    { "id": "talk_02",   "category": "smalltalk", "text": "Früher war ich Fernfahrer. Jetzt fahr ich gar nichts mehr." },
    { "id": "talk_03",   "category": "smalltalk", "text": "Trau keinem an der Küste." },
    { "id": "talk_04",   "category": "smalltalk", "text": "Hmpf." },
    { "id": "talk_05",   "category": "smalltalk", "text": "Die Städte sind voll mit den Dingern. Bleib in den Wäldern." },
    { "id": "bye_01",    "category": "abschied",  "text": "Pass auf dich auf." },
    { "id": "bye_02",    "category": "abschied",  "text": "Man sieht sich. Oder auch nicht." },
    { "id": "bye_03",    "category": "abschied",  "text": "Ich zieh weiter." },
    { "id": "yes_01",    "category": "antwort",   "text": "Ja." },
    { "id": "no_01",     "category": "antwort",   "text": "Nein." },
    { "id": "maybe_01",  "category": "antwort",   "text": "Mal sehen." }
  ]
}
