# ===========================================================================
# dayz-ai-survivor — environment variable reference (.env.example)
# ===========================================================================
# This is the authoritative list of every environment variable the project
# reads. Copy it to ".env" for reference, but note: the daemons read the OS
# environment, they do NOT auto-load a .env file. Set the variables one of
# two ways:
#
#   Windows (persistent, recommended):
#       setx ANTHROPIC_API_KEY "sk-ant-..."
#       (open a NEW terminal afterwards — setx only affects new processes)
#       The interactive helper tools/set_api_keys.ps1 sets the cloud keys.
#
#   Current shell only (PowerShell):
#       $env:ANTHROPIC_API_KEY = "sk-ant-..."
#
# Leave a variable unset to use its built-in default. NEVER commit real
# values — .env is git-ignored.
# ---------------------------------------------------------------------------

# === Claude (the survivor brain) ===========================================
# Claude Code is the engine. Two ways to authenticate:
#   1. Max/Pro plan login  -> run `claude` once and /login (no key needed,
#      used for the bare model names: sonnet, opus, haiku).
#   2. Pay-per-token API   -> set this key; selecting an "api/..." model in
#      the in-game menu forces the real Anthropic API instead of the plan.
ANTHROPIC_API_KEY=

# === Other cloud LLM providers (optional, via claude-code-router) ==========
# Only needed if you pick an "openai/", "google/" or "xai/" model in-game.
# Get keys: https://platform.openai.com/api-keys
#           https://aistudio.google.com/apikey   (free tier available)
#           https://console.x.ai
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# === Voice (ElevenLabs: text-to-speech + speech-to-text) ===================
# Required for Discord voice output and microphone listening.
# Get a key: https://elevenlabs.io  ->  Profile  ->  API Keys
ELEVENLABS_API_KEY=

# === Discord voice bots ====================================================
# Each NPC speaks through its OWN Discord bot application (own token).
# Create the bots and copy each token here — see docs/discord_bot_setup_en.md.
# Slots without a dedicated token fall back to the collective DISCORD_BOT_TOKEN.
DISCORD_BOT_TOKEN=
DISCORD_TOKEN_VIKTOR=
DISCORD_TOKEN_BIRGIT=
DISCORD_TOKEN_IGOR=
DISCORD_TOKEN_KONRAD=
# Voice channel the bots join (default: DayZ). Must match a channel on your server.
ISU_DISCORD_CHANNEL=DayZ

# === Player identity =======================================================
# ISU_MIC_NAME      : how YOU appear on the radio / in voice (the name the NPCs
#                     listen for). Usually overridden by the in-game setup menu.
# ISU_PLAYER_NAME   : your DayZ profile name (GetIdentity), if it differs from
#                     the radio name. Leave empty to resolve it live from the world.
# ISU_PLAYER_NAMES  : optional comma list of every name you can be addressed by,
#                     e.g. "Player,MyProfileName". Defaults to ISU_MIC_NAME.
ISU_MIC_NAME=Player
ISU_PLAYER_NAME=
ISU_PLAYER_NAMES=

# === Microphone (push-to-talk voice input) =================================
# ISU_MIC_DEVICE    : index or name fragment of the input device
#                     (list devices: python daemon/mic_select.py).
# ISU_MIC_THRESHOLD : RMS gate; leave empty for auto-calibration.
ISU_MIC_DEVICE=
ISU_MIC_THRESHOLD=

# === Tool paths (override only if auto-detection fails) ====================
# ISU_NODE_BIN   : full path to node(.exe). Auto-detected from PATH if unset.
# ISU_CLAUDE_CLI : full path to the Claude Code cli.js. Auto-detected from the
#                  global npm install if unset.
ISU_NODE_BIN=
ISU_CLAUDE_CLI=

# === DayZ install locations ================================================
# Point these at YOUR DayZ install. Defaults assume the standard Steam library.
# A custom library (e.g. on D:) must be set here or passed to the PS1 scripts.
DAYZ_SERVER_DIR=C:\Program Files (x86)\Steam\steamapps\common\DayZServer
DAYZ_DIR=C:\Program Files (x86)\Steam\steamapps\common\DayZ
DAYZ_WORKSHOP_DIR=C:\Program Files (x86)\Steam\steamapps\workshop\content\221100
DAYZ_TOOLS_DIR=C:\Program Files (x86)\Steam\steamapps\common\DayZ Tools
